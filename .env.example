# =============================================================================
# Financial Report RAG Assistant - configuration template
# Copy to .env and adjust. NEVER commit the real .env file.
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=finrag
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=finrag
POSTGRES_PORT=5432
# Consumed by the .NET backend (Npgsql connection string format)
DATABASE_URL=Host=localhost;Port=5432;Database=finrag;Username=finrag;Password=change-me-in-local-env

# --- Service URLs -----------------------------------------------------------
BACKEND_URL=http://localhost:5080
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- ChromaDB ---------------------------------------------------------------
# When set, the AI service talks to a Chroma server. Leave EMPTY to use an
# embedded persistent Chroma store at CHROMA_PERSIST_DIR (simplest local setup).
CHROMA_URL=
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=financial_reports

# --- Foundry Local ----------------------------------------------------------
# Foundry Local binds to a DYNAMIC port. Find yours with:  foundry server status
FOUNDRY_LOCAL_URL=http://127.0.0.1:52527
# Chat and embedding models are split across devices on purpose: generation is
# the latency bottleneck and gets the GPU, embeddings are small and run on CPU.
# This pair is sized for a 4 GB GPU. With >= 8 GB VRAM you can move up to:
#   FOUNDRY_MODEL=phi-4-mini
#   FOUNDRY_EMBEDDING_MODEL=qwen3-embedding-0.6b-cuda-gpu
# Verify any replacement model actually produces coherent text -- some Foundry
# execution-provider builds (e.g. phi-3.5-mini on TensorRT-RTX) emit garbage.
FOUNDRY_MODEL=qwen2.5-1.5b
FOUNDRY_EMBEDDING_MODEL=qwen3-embedding-0.6b-generic-cpu
FOUNDRY_TIMEOUT_SECONDS=180
FOUNDRY_MAX_TOKENS=500
FOUNDRY_TEMPERATURE=0.1
# Models must be resident before use (`foundry model load <alias>`). When true,
# the AI service runs that command itself on first use. Only works when it
# shares a host with the Foundry CLI.
FOUNDRY_AUTO_LOAD=true
# The daemon binds a NEW random port on every restart. When true, the service
# asks the CLI (`foundry server status`) for the live port if the configured
# URL stops responding. Requires the Foundry CLI on PATH.
FOUNDRY_AUTO_DISCOVER=true

# --- RAG tuning -------------------------------------------------------------
TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
SIMILARITY_THRESHOLD=0.25
MAX_CONTEXT_CHARS=8000
EMBEDDING_BATCH_SIZE=8

# --- AI service runtime -----------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO

# --- Frontend (Vite: only VITE_* vars reach the browser) --------------------
VITE_API_BASE_URL=http://localhost:5080/api

# --- Dataset downloaders ----------------------------------------------------
# SEC EDGAR requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT=FinAI-Research your.email@example.com

# Kaggle is the secondary corpus source: annual report PDFs, which carry real
# page numbers (EDGAR's HTML filings have none, so those rely on synthetic
# pagination). Credentials are required even for public datasets -- either put
# kaggle.json in ~/.kaggle/ or fill these in.
# Token: https://www.kaggle.com/settings -> API -> "Create New Token"
KAGGLE_DATASET=samarthagarwal23/annual-reports
KAGGLE_USERNAME=
KAGGLE_KEY=
